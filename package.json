{
  "name": "sartoria",
  "version": "0.1.0",
  "private": true,
  "description": "Premium personal wardrobe and style system",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "db:auth:migrate": "auth migrate",
    "verify:production-env": "node scripts/verify-production-env.mjs",
    "verify:staging-images": "node scripts/verify-staging-images.mjs",
    "verify:staging-package": "node scripts/verify-staging-package.mjs",
    "verify:staging": "node scripts/verify-staging.mjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1093.0",
    "@aws-sdk/s3-presigned-post": "3.1093.0",
    "@aws-sdk/s3-request-presigner": "3.1093.0",
    "better-auth": "1.6.23",
    "file-type": "22.0.1",
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "auth": "1.6.23",
    "eslint": "9.39.3",
    "eslint-config-next": "16.2.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}