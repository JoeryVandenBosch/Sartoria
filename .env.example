# Local development defaults
SARTORIA_AUTH_MODE=development
SARTORIA_PERSISTENCE_MODE=memory
SARTORIA_MEDIA_MODE=development
SARTORIA_RECOMMENDATION_MODE=fallback

# Deployed identity and persistence
# Set to staging or production. The production environment verifier rejects other values.
# SARTORIA_DEPLOYMENT_ENV=staging
# SARTORIA_AUTH_MODE=better-auth
# SARTORIA_PERSISTENCE_MODE=postgres
# DATABASE_URL=postgres://user:password@host:5432/sartoria
# DATABASE_SSL_MODE=require
# BETTER_AUTH_URL=https://sartoria.example.com
# BETTER_AUTH_SECRET=replace-with-at-least-32-bytes-of-high-entropy-secret

# Audited one-time staging identity bootstrap
# Never enable in production. Remove the token immediately after bootstrap.
# SARTORIA_OWNER_BOOTSTRAP_ENABLED=false
# SARTORIA_OWNER_BOOTSTRAP_TOKEN=replace-with-at-least-64-characters-of-high-entropy-secret

# Production private media
# SARTORIA_MEDIA_MODE=production
# MEDIA_S3_BUCKET=sartoria-private-media
# MEDIA_S3_REGION=eu-west-1
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_FORCE_PATH_STYLE=false
# MEDIA_S3_SERVER_SIDE_ENCRYPTION=AES256
# MEDIA_PROCESSING_QUEUE_URL=https://worker.example.com/api/media/process
# MEDIA_PROCESSING_QUEUE_TOKEN=replace-with-at-least-32-bytes-of-high-entropy-secret
# MEDIA_WORKER_TOKEN=replace-with-at-least-32-bytes-of-high-entropy-secret
# CLAMAV_HOST=clamav.internal
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# Optional provider-neutral recommendation endpoint
# Keep SARTORIA_RECOMMENDATION_MODE=fallback for deterministic wardrobe-only advice.
# SARTORIA_RECOMMENDATION_MODE=provider
# RECOMMENDATION_PROVIDER_URL=https://recommendation-gateway.example.com/v1/generate
# RECOMMENDATION_PROVIDER_SECRET=replace-with-at-least-32-bytes-of-high-entropy-secret
# RECOMMENDATION_PROVIDER_NAME=approved-provider
# RECOMMENDATION_PROVIDER_MODEL=approved-model-identifier
# RECOMMENDATION_PROVIDER_TIMEOUT_MS=15000

# Operational observability (see docs/operations/observability.md).
# Sink selection is a closed enumeration: console or none. There is no
# external-endpoint option; adding one requires a code change and an ADR.
# SARTORIA_OBSERVABILITY_SINK=console
# SARTORIA_RELEASE=1.0.0

# Rate limiting (see docs/operations/rate-limiting.md).
# Client-scoped policies (auth, internal) require a trusted proxy; without
# this they report themselves unenforceable and permit every request.
# SARTORIA_TRUST_PROXY_HEADERS=true
# SARTORIA_RATE_LIMIT_DISABLED=false
# SARTORIA_RATE_LIMIT_AUTH_ATTEMPTS=10
# SARTORIA_RATE_LIMIT_MEDIA_UPLOADS=60
# SARTORIA_RATE_LIMIT_RECOMMENDATIONS=30
# SARTORIA_RATE_LIMIT_PROFILE_EXPORTS=10
# SARTORIA_RATE_LIMIT_INTERNAL=30
