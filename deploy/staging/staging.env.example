NODE_ENV=production
SARTORIA_AUTH_MODE=better-auth
SARTORIA_PERSISTENCE_MODE=postgres
SARTORIA_MEDIA_MODE=production
SARTORIA_RECOMMENDATION_MODE=fallback

DATABASE_URL=
DATABASE_SSL_MODE=disable
BETTER_AUTH_URL=https://sartoria-staging.example.com
BETTER_AUTH_SECRET=

MEDIA_S3_BUCKET=sartoria-staging-private-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=https://media-sartoria-staging.example.com
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_SERVER_SIDE_ENCRYPTION=AES256
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MEDIA_PROCESSING_QUEUE_URL=https://sartoria-staging.example.com/api/internal/media/process
MEDIA_PROCESSING_QUEUE_TOKEN=
MEDIA_WORKER_TOKEN=

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
