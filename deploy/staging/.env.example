# Copy to deploy/staging/.env and replace every placeholder.
# Pin all service images to approved immutable digests before deployment.
POSTGRES_IMAGE=postgres:17-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_CLIENT_IMAGE=minio/mc:latest
CLAMAV_IMAGE=clamav/clamav:stable
CADDY_IMAGE=caddy:2-alpine

STAGING_HOST=sartoria-staging.example.com
STAGING_STORAGE_HOST=media-sartoria-staging.example.com
ACME_EMAIL=operations@example.com

POSTGRES_DB=sartoria
POSTGRES_USER=sartoria_runtime
POSTGRES_PASSWORD=replace-with-high-entropy-database-password

MINIO_ROOT_USER=replace-with-high-entropy-storage-user
MINIO_ROOT_PASSWORD=replace-with-high-entropy-storage-password
MEDIA_S3_BUCKET=sartoria-staging-private-media
